    "text": "\"\"\"One bounded owned replay client; preserve raw capture and all tool failures.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport runpy\nimport shutil\nimport signal\nimport subprocess\nimport time\nfrom collections.abc import Callable\nfrom pathlib import Path\nfrom typing import cast\n\ntype Object = dict[str, object]\nROOT = Path(\"/Users/teilomillet/Code/wyat/benchmarks/analysis/results\")\nSOURCE = ROOT / \"mlx-ready-capture2-tile32-bf16.gputrace\"\nCOPY = ROOT / \"mlx-ready-replay32.gputrace\"\nOUTPUT = ROOT / \"mlx-ready-profile32.json\"\nhelper = runpy.run_path(\n    \"/private/tmp/wyat-metal-ready-capture.py\", run_name=\"inventory_only\"\n)\ninventory = cast(Callable[[Path], Object], helper[\"inventory\"])\noriginal = inventory(SOURCE)\nassert not OUTPUT.exists() and not COPY.exists()\nshutil.copytree(SOURCE, COPY, symlinks=True)\ncopied = inventory(COPY)\nassert original[\"manifest_sha256\"] == copied[\"manifest_sha256\"]\ncommands = [\n    \"status\",\n    \"profile run --exec serial --gpu-state default\",\n    \"go /performance/shaders\",\n    \"list --all\",\n    \"info --all\",\n    \"go /performance/commands\",\n    \"list --all\",\n    \"info --all\",\n    \"go /resources/compute_pipelines\",\n    \"list --all\",\n    \"info cps0 --all\",\n    \"find wyat\",\n    \"profile\",\n]\nargv = [\n    \"/usr/bin/gpudebug\",\n    \"--oneshot\",\n    \"--json\",\n    \"--timeout\",\n    \"45\",\n    \"-t\",\n    str(COPY),\n    \"-o\",\n    str(ROOT / \"mlx-ready-profile32-resources\"),\n]\nfor command in commands:\n    argv.extend([\"-c\", command])\npayload: Object = {\n    \"completed\": False,\n    \"command\": argv,\n    \"timeout_seconds\": 120,\n    \"timed_out\": False,\n    \"profiled_selection_timing\": False,\n    \"script_source\": {\n        \"sha256\": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n        \"text\": Path(__file__).read_text(),\n    },\n    \"original_capture\": original,\n    \"replay_copy_before\": copied,\n    \"no_embed_requested\": True,\n    \"process_cleanup_scope\": \"owned client process group only\",\n    \"session_cleanup_observed\": False,\n    \"session_cleanup_limit\": \"Oneshot automatic server cleanup is documented, but actual server termination requires independent observation.\",\n}\n\n\ndef save() -> None:\n    OUTPUT.write_text(json.dumps(payload, indent=2, allow_nan=False) + \"\\n\")\n\n\nsave()\nstarted = time.perf_counter()\nwith (\n    OUTPUT.with_suffix(\".stdout.log\").open(\"x\") as stdout,\n    OUTPUT.with_suffix(\".stderr.log\").open(\"x\") as stderr,\n):\n    child = subprocess.Popen(argv, stdout=stdout, stderr=stderr, start_new_session=True)\n    payload[\"client_pid\"] = child.pid\n    payload[\"client_session_leader\"] = child.pid\n    save()\n    try:\n        code = child.wait(timeout=120)\n    except subprocess.TimeoutExpired:\n        payload[\"timed_out\"] = True\n        code = 124\n    finally:\n        try:\n            os.killpg(child.pid, signal.SIGKILL)\n        except ProcessLookupError:\n            pass\n        child.wait()\npayload.update(\n    exit_code=code,\n    completed=code == 0,\n    client_reaped=True,\n    elapsed_seconds=time.perf_counter() - started,\n    original_capture_after=inventory(SOURCE),\n    replay_copy_after=inventory(COPY),\n)\nassert (\n    cast(Object, payload[\"original_capture_after\"])[\"manifest_sha256\"]\n    == original[\"manifest_sha256\"]\n)\nfor field, suffix in [(\"stdout\", \".stdout.log\"), (\"stderr\", \".stderr.log\")]:\n    path = OUTPUT.with_suffix(suffix)\n    raw = path.read_bytes()\n    payload[field] = {\n        \"path\": str(path),\n        \"sha256\": hashlib.sha256(raw).hexdigest(),\n        \"bytes\": len(raw),\n    }\nsave()\nprint(\n    json.dumps(\n        {\n            key: value\n            for key, value in payload.items()\n            if key\n            in [\n                \"command\",\n                \"timeout_seconds\",\n                \"timed_out\",\n                \"exit_code\",\n                \"client_pid\",\n                \"client_reaped\",\n                \"elapsed_seconds\",\n                \"completed\",\n                \"session_cleanup_observed\",\n            ]\n        }\n    )\n)\n"
