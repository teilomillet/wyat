    "text": "\"\"\"Independent framework-free verification of local attention preparation evidence.\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import cast\n\nROOT = Path('/Users/teilomillet/Code/wyat')\nRESULTS = ROOT / 'benchmarks/analysis/results'\n\n\ndef obj(value: object) -> dict[str, object]:\n    assert isinstance(value, dict)\n    return cast(dict[str, object], value)\n\n\ndef sequence(value: object) -> list[object]:\n    assert isinstance(value, list)\n    return cast(list[object], value)\n\n\ndef unique(items: list[tuple[str, object]]) -> dict[str, object]:\n    result: dict[str, object] = {}\n    for name, value in items:\n        assert name not in result\n        result[name] = value\n    return result\n\n\ndef nonfinite(token: str) -> object:\n    raise ValueError(token)\n\n\ndef read(path: Path) -> dict[str, object]:\n    return obj(json.loads(path.read_bytes(), object_pairs_hook=unique, parse_constant=nonfinite))\n\n\ndef sha(path: Path) -> str:\n    with path.open('rb') as stream:\n        return hashlib.file_digest(stream, 'sha256').hexdigest()\n\n\ndef main() -> None:\n    started = time.perf_counter()\n    paths: dict[str, str] = {}\n    def pin(path: Path, expected: str | None = None) -> None:\n        value = sha(path)\n        assert expected is None or value == expected, str(path)\n        paths[str(path)] = value\n    receipt_path = ROOT / 'benchmarks/real/engine-attention-verification.json'\n    pin(receipt_path)\n    receipt = read(receipt_path)\n    archive_path = Path(cast(str, obj(receipt['source_archive'])['path']))\n    pin(archive_path, 'e21212cd0e76a537f0745721a67162a6ed546f23e647b84383b97303efc5625c')\n    assert obj(receipt['source_archive'])['sha256'] == paths[str(archive_path)]\n    sources = [obj(x) for x in sequence(read(archive_path)['files'])]\n    table = obj(receipt['source_sha256'])\n    assert len(sources) == len(table) == receipt['maintained_python_files'] == 129\n    assert len({x['path'] for x in sources}) == 129\n    for source in sources:\n        name = cast(str, source['path'])\n        value = hashlib.sha256(cast(str, source['text']).encode()).hexdigest()\n        assert table[name] == source['sha256'] == value\n        pin(ROOT / name, value)\n    old_path = ROOT / 'benchmarks/real/engine-unroll-cuda-verification.json'\n    pin(old_path)\n    old = obj(read(old_path)['source_sha256'])\n    assert len(old) == 123\n    assert all(table[name] == value for name, value in old.items())\n    production = {name: value for name, value in table.items() if name.startswith('wyat/')}\n    assert len(production) == 20\n    assert obj(receipt['production_identity'])['unchanged_files'] == 20\n    assert receipt['completed'] is True and receipt['source_bytes_unchanged_after_checks'] is True\n    verifier = obj(receipt['verifier'])\n    assert hashlib.sha256(cast(str, verifier['text']).encode()).hexdigest() == verifier['sha256']\n    checks = obj(receipt['checks'])\n    for name, raw in checks.items():\n        check = obj(raw)\n        assert check['exit_code'] == 0 and check['timed_out'] is False and check['reaped'] is True\n        assert float(cast(float, check['seconds'])) < cast(int, check['cap_seconds'])\n        assert type(check['pid']) is int and check['stderr'] == ''\n        assert isinstance(check['command'], list)\n    stdout = cast(str, obj(checks['pytest'])['stdout'])\n    assert '733 passed, 1 warning in 12.41s' in stdout and 'skipped' not in stdout and 'failed' not in stdout\n    assert obj(checks['pytest'])['cap_seconds'] == 120\n    assert obj(checks['ruff_lint'])['stdout'] == 'All checks passed!\\n'\n    assert obj(checks['ruff_format'])['stdout'] == '135 files already formatted\\n'\n    assert obj(checks['mypy'])['stdout'] == 'Success: no issues found in 129 source files\\n'\n    manifest_path = RESULTS / 'cuda-transfer-manifest-v2-20261005.json'\n    pin(manifest_path, 'f7d9d7a4755a8df37e7e55d577489a1f9597760a68928b2a8213a0d19d3c6866')\n    assets = [obj(x) for x in sequence(read(manifest_path)['files'])]\n    assert len(assets) == 44\n    for asset in assets:\n        path = ROOT / cast(str, asset['path'])\n        assert path.stat().st_size == asset['bytes']\n        pin(path, cast(str, asset['sha256']))\n    declaration_path = RESULTS / 'cuda-attention-source-declaration-20261005.json'\n    pin(declaration_path, '71f72524e94055a7626dfc1d74af63508dfbb4578d3816090cd79cdf69328ad7')\n    declaration = read(declaration_path)\n    assert len(declaration) == 7\n    for name, value in declaration.items():\n        pin(ROOT / name, cast(str, value))\n        if name.endswith('.py'):\n            assert table[name] == value\n    for name, expected in (\n        ('cuda-fp32-b1.json', 'd528a44e19ceb6097ea81081d7e57fd97454a26777e45f3a284cb52d044c5167'),\n        ('cuda-fp32-b1.wall.json', 'cb00f5f065a04e5c598da04cb3e57a7b75bbaedeb1407dc6ebbb0dd806f4dc8e'),\n        ('cuda-fp32-b1-review.json', '1a5d5118549d6e3c0fee67378d859abd269f565d4f3f07a4f1b8f61ebb0f287e'),\n        ('cuda-fp32-b1.sources-ae4a797635edfbd1.json', 'ae4a797635edfbd146bd9bd8ce4df436ce599f601c6ab942f3779e4da32308cf'),\n    ):\n        pin(RESULTS / name, expected)\n    output = RESULTS / 'cuda-attention-local-review.json'\n    source = Path(__file__).read_bytes()\n    source_sha = hashlib.sha256(source).hexdigest()\n    archive = output.with_suffix(f'.audit-{source_sha[:16]}.txt')\n    with archive.open('xb') as stream:\n        stream.write(source)\n    result = dict(passed=True,scope='Framework-free local tooling preparation audit; no model/GPU execution',\n                  captured_utc=datetime.now(timezone.utc).isoformat(),source_count=129,preserved_prior_sources=123,\n                  production_files_unchanged=20,asset_count=44,new_declaration_files=7,pytest=dict(passed=733,skipped=0,warnings=1,child_seconds=12.41,parent_seconds=obj(checks['pytest'])['seconds']),\n                  recorded_checks=checks,archive_sha256=paths[str(archive_path)],artifact_sha256=paths,\n                  audit_script=dict(path=str(archive),sha256=source_sha,text=source.decode()),\n                  elapsed_seconds=time.perf_counter()-started,frameworks_imported=[x for x in ('torch','transformers','mlx','numpy') if x in sys.modules],\n                  limits=['Verification rechecks recorded command outcomes and exact source bytes; it does not independently rerun tests.',\n                          '733 native local tests support tooling only; efficient CUDA eligibility, actual GPU dispatch, first8/full77 model quality and speed remain unknown.',\n                          'Ruff135 and typed129 are distinct recorded command scopes; historical results/source text archives are not maintained Python modules.',\n                          'User-approved exact transfer remains operationally separate; this audit performs no network or GPU allocation.'])\n    assert result['frameworks_imported'] == []\n    with output.open('x') as stream:\n        json.dump(result,stream,indent=2,allow_nan=False);stream.write('\\n')\n    print(json.dumps(dict(path=str(output),sha256=sha(output),passed=True,elapsed_seconds=result['elapsed_seconds'])))\n\n\nif __name__ == '__main__':\n    main()\n"
